{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jerinmiss620-web/Tavern-Layout-Engine/main/modules/manifest.schema.json",
  "title": "TLE Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "channel",
    "core_api_version",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "const": "Tavern Layout Engine"
    },
    "channel": {
      "enum": [
        "stable",
        "test"
      ]
    },
    "core_api_version": {
      "type": "integer",
      "minimum": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "api_version",
        "settings_schema_version",
        "source_commit",
        "source_path",
        "source_url",
        "sha256",
        "size_bytes",
        "parent_id",
        "dependencies",
        "permissions",
        "enabled_by_default"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "api_version": {
          "type": "integer",
          "minimum": 1
        },
        "settings_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/jerinmiss620-web/Tavern-Layout-Engine/[a-f0-9]{40}/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "parent_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){0,2}$"
          }
        },
        "enabled_by_default": {
          "type": "boolean"
        }
      }
    }
  }
}
